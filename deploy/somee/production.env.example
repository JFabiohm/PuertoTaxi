# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore: NO se sube a Git.
# El parser de publish.sh no interpreta $, comillas ni ';', así que puedes pegar
# la connection string tal cual la muestra Somee.

# ------------------------------- Sitio ------------------------------------
# Dominio principal del website en Somee, sin https:// ni barra final.
SOMEE_HOST=tuusuario.somee.com
# Hosts alternativos (www, dominio propio...), separados por coma.
SOMEE_EXTRA_HOSTS=www.tuusuario.somee.com
# URL pública de la API (http mientras el site no tenga SSL binding).
SOMEE_SITE_URL=http://tuusuario.somee.com
# true solo si el site tiene certificado SSL. Si no, la API no redirige a https.
SOMEE_HTTPS=false
# RID del app pool de Somee (x86 en el plan free). Vacío = sin RID.
SOMEE_RID=win-x86
# hostingModel de ANCM; OutOfProcess evita bloqueos de DLL al actualizar.
SOMEE_HOSTING_MODEL=OutOfProcess
# Forzar hosts permitidos (vacío = SOMEE_HOST + SOMEE_EXTRA_HOSTS).
SOMEE_ALLOWED_HOSTS_OVERRIDE=
# URL que se escribe en frontend/.env. Igual al origen de Netlify para usar
# las reescrituras de public/_redirects y evitar mixed content.
FRONTEND_API_URL=https://tu-sitio.netlify.app

# ----------------------------- Base de datos -------------------------------
# Cópiala exacta desde: MS SQL Databases > [tu BD] > Connection details.
CONNECTION_STRING=Server=...;Database=...;User Id=...;Password=...;

# ------------------------------- Seguridad ---------------------------------
# JWT: mínimo 32 caracteres; mejor 48+ aleatorios.
JWT_KEY=CAMBIA-ESTA-CLAVE-POR-UNA-ALEATORIA-DE-48-CARACTERES-MINIMO

# El API crea este usuario admin en el primer arranque si no existe.
SEED_ADMIN_EMAIL=admin@puertotaxi.local
SEED_ADMIN_PHONE=50600000000
SEED_ADMIN_PASSWORD=CAMBIA-ESTA-CONTRASENA

# Orígenes del frontend separados por coma (Firebase / Netlify / el que uses).
# Si lo dejas vacío, no se permiten peticiones CORS desde otros dominios.
FRONTEND_ORIGINS=https://tu-frontend.web.app,https://tu-frontend.netlify.app

# ------------------------------ WhatsApp -----------------------------------
# Opcional. Si lo dejas vacío, el código OTP se escribe en el log del API.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Solo para el reporte de emergencias (no hace falta para el OTP).
WHATSAPP_CENTRAL_PHONE_NUMBER=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE_NAME=puertotaxi_otp
# Código de idioma de la plantilla aprobada en Meta (es, es_CR, en...).
WHATSAPP_OTP_TEMPLATE_LANGUAGE=es

# ------------------------------ Opciones IIS --------------------------------
# SignalR necesita WebSockets. Somee lo ofrece en algunos planes; si el panel
# lo permite y quieres activarlo, pon true. Si da error 500.19, vuelve a false.
SOMEE_ENABLE_WEBSOCKET=false
# Para diagnosticar fallos de arranque pon true (genera logs\stdout_*.log).
# Ten cuidado: el plan free tiene poco espacio y los logs no se rotan.
SOMEE_STDOUT_LOG=false
# Log del módulo ANCM; solo para diagnosticar 500.30.
SOMEE_ANCM_DEBUG=false

# -------------------------------- FTP --------------------------------------
# El FTP del website usa el MISMO dominio del site (no el FTP de backups).
SOMEE_FTP_HOST=tuusuario.somee.com
SOMEE_FTP_PORT=21
SOMEE_FTP_USER=
SOMEE_FTP_PASSWORD=
# Somee usa FTP plano.
SOMEE_FTP_TLS=false
SOMEE_REMOTE_ROOT=/www.tuusuario.somee.com
# Borra el contenido remoto antes de subir (plan free: 150 MB).
SOMEE_FTP_CLEAN=true
